---
import '../styles/global.css';
import { getCanonicalUrl, getLocalizedUrl, getDictionary } from '../i18n';
import type { Locale } from '../i18n';
import { domainI18nEnabled } from '../i18n/config';

interface Props { locale: Locale; page: 'landing' | 'catalog'; preview?: boolean; }
const { locale, page, preview = false } = Astro.props;
const copy = getDictionary(locale);
const title = page === 'catalog' ? copy.meta.catalogTitle : copy.meta.landingTitle;
const description = page === 'catalog' ? copy.meta.catalogDescription : copy.meta.landingDescription;
const publicPath = page === 'catalog' ? '/catalog' : '/';
const canonical = getCanonicalUrl(locale, publicPath);
const timeweb = import.meta.env.PUBLIC_LANDING_HOSTING === 'timeweb';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#050b0e" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonical} />
    {preview && <meta name="robots" content="noindex,follow" />}
    {(preview || domainI18nEnabled) && <link rel="alternate" hreflang="ru" href={getLocalizedUrl({ locale: 'ru', pathname: publicPath })} />}
    {(preview || domainI18nEnabled) && <link rel="alternate" hreflang="en" href={getLocalizedUrl({ locale: 'en', pathname: publicPath })} />}
    {(preview || domainI18nEnabled) && <link rel="alternate" hreflang="x-default" href={getLocalizedUrl({ locale: 'en', pathname: publicPath })} />}
    {timeweb ? <link rel="stylesheet" href="/fonts/timeweb/fonts.css" /> : <>
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;1,500&family=Inter+Tight:wght@500&display=swap" rel="stylesheet" />
    </>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { getAppTarget, getLoginTarget } from '../lib/attribution';
      import { trackEvent } from '../lib/analytics';

      document.documentElement.dataset.motion = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'reduced' : 'full';
      document.querySelectorAll<HTMLAnchorElement>('[data-login-link]').forEach((link) => {
        link.href = getAppTarget(new URL(getLoginTarget()).pathname);
        link.addEventListener('click', () => trackEvent('login_clicked'));
      });
      document.querySelectorAll<HTMLAnchorElement>('[data-app-target]').forEach((link) => {
        link.href = getAppTarget();
      });
      document.querySelectorAll<HTMLAnchorElement>('[data-catalog-link]').forEach((link) => {
        link.addEventListener('click', () => trackEvent('catalog_clicked', { source: link.dataset.catalogSource ?? 'header' }));
      });
      document.querySelectorAll<HTMLAnchorElement>('[data-faq-link]').forEach((link) => {
        link.addEventListener('click', () => trackEvent('faq_clicked', { source: link.dataset.faqSource ?? 'header' }));
      });
      document.querySelectorAll<HTMLAnchorElement>('[data-support-link]').forEach((link) => {
        link.addEventListener('click', () => trackEvent('support_clicked', { source: link.dataset.supportSource }));
      });
      document.querySelectorAll<HTMLAnchorElement>('[data-contact-link]').forEach((link) => {
        link.addEventListener('click', () => trackEvent('contact_clicked', { source: link.dataset.contactSource }));
      });
      window.dispatchEvent(new CustomEvent('dreamwheels:landing-viewed'));
    </script>
  </body>
</html>
