---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Dream Wheels AI — See the fit before you buy' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0b0c0d" />
    <meta name="description" content="Choose a wheel, check preliminary compatibility, and see it on your car." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      document.documentElement.dataset.motion = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'reduced' : 'full';
      window.dispatchEvent(new CustomEvent('dreamwheels:landing-viewed'));
    </script>
  </body>
</html>
