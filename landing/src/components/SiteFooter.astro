---
const supportUrl = 'https://t.me/dreamwheelsai';
import { getDictionary, getLocalizedUrl } from '../i18n';
import type { Locale } from '../i18n';
import { domainI18nEnabled } from '../i18n/config';
interface Props { locale: Locale; preview?: boolean; }
const { locale, preview = false } = Astro.props;
const copy = getDictionary(locale);
const local = (pathname: string) => preview && !domainI18nEnabled ? getLocalizedUrl({ locale, pathname, preview: true }) : pathname;
const legalBaseUrl = locale === 'en' ? 'https://legal.dreamwheels.pro/en/legal' : 'https://dream-wheels-ai-legal.vercel.app/legal';
const agreementPath = locale === 'en' ? 'terms' : 'offer';
---

<footer class="site-footer" id="contacts">
  <div class="site-footer__brand">
    <strong>{copy.footer.brand}</strong>
    <small>{copy.footer.copyright}</small>
  </div>
  <nav class="site-footer__links" aria-label={copy.footer.navigationLabel}>
    <a href={local('/catalog')} data-catalog-link data-catalog-source="footer">{copy.nav.catalog}</a>
    <a href={`${local('/')}#faq`} data-faq-link data-faq-source="footer">{copy.nav.faq}</a>
    <a href={supportUrl} target="_blank" rel="noreferrer" data-support-link data-support-source="footer">{copy.footer.support}</a>
    <a href={`mailto:${copy.footer.email}`} data-contact-link data-contact-source="footer_email">{copy.footer.email}</a>
  </nav>
  <div class="site-footer__legal">
    <a href={`${legalBaseUrl}/privacy`} target="_blank" rel="noreferrer">{copy.footer.privacy}</a>
    <a href={`${legalBaseUrl}/${agreementPath}`} target="_blank" rel="noreferrer">{copy.footer.agreement}</a>
  </div>
</footer>
