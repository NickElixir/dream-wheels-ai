---
import Layout from '../layouts/Layout.astro';
import MiniCatalog from '../components/MiniCatalog';
---

<Layout>
  <header class="site-header">
    <a class="wordmark" href="#top" aria-label="Dream Wheels AI — на главную">DREAMWHEELS <span>AI</span></a>
    <nav class="main-nav" aria-label="Основная навигация">
      <a href="#catalog">Как это работает</a>
      <a href="#catalog">Примеры</a>
      <a href="#catalog">FAQ</a>
    </nav>
    <div class="header-actions">
      <a class="login-link" href="https://dreamwheels.pro/app/new" data-login-link>Войти</a>
      <a class="button button-small button-lime action-type" href="https://dreamwheels.pro/app/new" data-primary-cta>Попробовать <span aria-hidden="true">→</span></a>
    </div>
  </header>

  <main>
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-media" aria-label="Автомобиль в тёмном гараже">
        <img src="/assets/mock/zeekr-001.webp" width="1536" height="1024" alt="Временный mock-ассет Zeekr 001 в гараже" fetchpriority="high" />
        <div class="hero-media-shade" aria-hidden="true"></div>
        <div class="hero-caption"><span>ZEEKR 001</span><span>SAME CAR / A DIFFERENT STORY</span><span>01 / 15</span></div>
      </div>
      <div class="hero-copy">
        <span class="eyebrow">YOUR CAR. NEW POSSIBILITIES.</span>
        <h1 id="hero-title">БОЛЬШЕ<br />СТИЛЯ<br />В ВАШИХ<br />РУКАХ</h1>
        <p>Примерьте конкретные диски на своей машине и посмотрите, как они выглядят, с предварительной проверкой совместимости.</p>
        <a class="button button-lime action-type hero-cta" href="https://dreamwheels.pro/app/new" data-primary-cta>Примерить диски на своей машине <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="catalog-section" id="catalog" aria-labelledby="catalog-title">
      <MiniCatalog client:load />
    </section>
  </main>

  <script>
    import { getAppTarget } from '../lib/attribution';
    import { trackEvent } from '../lib/analytics';

    document.querySelectorAll<HTMLAnchorElement>('[data-primary-cta], [data-login-link]').forEach((link) => {
      link.href = getAppTarget();
      link.addEventListener('click', () => trackEvent(link.hasAttribute('data-login-link') ? 'login_clicked' : 'primary_cta_clicked'));
    });
    window.addEventListener('dreamwheels:landing-viewed', () => trackEvent('landing_viewed'));
  </script>
</Layout>
