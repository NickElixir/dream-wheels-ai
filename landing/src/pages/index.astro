---
import Layout from '../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import heroImage from '../assets/hero/hero-geely-monjaro-refined.png';
import TwoQuestions from '../components/TwoQuestions';
import HowItWorks from '../components/HowItWorks.astro';
import BeforeAfter from '../components/BeforeAfter';
import SiteHeader from '../components/SiteHeader.astro';
import Faq from '../components/Faq';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout>
  <SiteHeader />

  <main>
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-media" aria-label="Geely Monjaro в открытом гараже">
        <Picture src={heroImage} widths={[640, 960, 1280, 1600, 1920]} sizes="100vw" formats={['avif', 'webp']} fallbackFormat="jpg" alt="Geely Monjaro в открытом гараже" loading="eager" fetchpriority="high" />
        <div class="hero-media-shade" aria-hidden="true"></div>
        <div class="hero-caption"><span>ВАШ АВТОМОБИЛЬ<br />ВАШИ ДИСКИ<br />ВАША УВЕРЕННОСТЬ</span></div>
      </div>
      <div class="hero-copy">
        <h1 id="hero-title">
          <span class="hero-welcome">Добро пожаловать</span>
          <span class="hero-brand">Dream Wheels</span>
        </h1>
        <p class="hero-subtitle">Посмотрите выбранные диски<br />на своём автомобиле</p>
      </div>
      <div class="hero-actions">
        <a class="button button-lime button-tactile action-type hero-cta" href="https://dreamwheels.pro/app/new" data-primary-cta>Попробовать</a>
        <span class="hero-cta-note">Первые 3 примерки бесплатно</span>
      </div>
    </section>

    <TwoQuestions />

    <HowItWorks />

    <BeforeAfter client:load />

    <Faq client:load />

  </main>

  <SiteFooter />

  <script>
    import { getAppTarget } from '../lib/attribution';
    import { trackEvent } from '../lib/analytics';

    document.querySelectorAll<HTMLAnchorElement>('[data-primary-cta]').forEach((link) => {
      link.href = getAppTarget();
      link.addEventListener('click', () => trackEvent('primary_cta_clicked', { source: link.dataset.primarySource ?? 'hero' }));
    });
    window.addEventListener('dreamwheels:landing-viewed', () => trackEvent('landing_viewed'));
  </script>
</Layout>
