---
const candidates = [
  { id: 'onest', family: 'Onest', display: 'Onest', note: 'Neutral, compact variable grotesk' },
  { id: 'commissioner', family: 'Commissioner', display: 'Commissioner', note: 'Structured variable grotesk' },
  { id: 'golos', family: 'Golos Text', display: 'Golos Text', note: 'Cyrillic-first text grotesk' },
  { id: 'manrope', family: 'Manrope', display: 'Manrope', note: 'Soft geometric sans' },
  { id: 'ibm-plex', family: 'IBM Plex Sans', display: 'IBM Plex Sans', note: 'Technical humanist sans' },
];

const systems = [
  {
    id: 'system-a',
    label: 'SYSTEM A',
    display: 'IBM Plex Sans only',
    note: 'One family for display, UI, body and technical values',
    supportFamily: 'IBM Plex Sans',
  },
  {
    id: 'system-b',
    label: 'SYSTEM B',
    display: 'IBM Plex Sans + Golos Text',
    note: 'IBM Plex Sans product voice / Golos Text reading voice',
    supportFamily: 'Golos Text',
  },
  {
    id: 'system-c',
    label: 'SYSTEM C',
    display: 'IBM Plex Sans + Commissioner',
    note: 'IBM Plex Sans product voice / Commissioner supporting voice',
    supportFamily: 'Commissioner',
  },
];

const buttonVariants = [
  { id: 'inter-tight-buttons', label: 'Inter Tight buttons', family: 'Inter Tight', note: 'Compact, crisp and contemporary action voice' },
];

---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Dream Wheels — Typeface Audition</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Commissioner:wght@100..900&family=Golos+Text:wght@400..900&family=IBM+Plex+Sans:wght@300;400;500;600;700&family=Inter+Tight:wght@400;500;600;700&family=Manrope:wght@200..800&family=Onest:wght@100..900&family=Roboto+Condensed:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="audition">
      <header class="audition-intro">
        <span>Dream Wheels / Typography audition</span>
        <h1>One layout.<br />Five voices.</h1>
        <p>Desktop-only comparison surface. All candidates use identical content, scale, color and spacing.</p>
      </header>

      {candidates.map((candidate) => (
        <section class="specimen" data-candidate={candidate.id} style={`--candidate: "${candidate.family}", sans-serif;`} aria-labelledby={`${candidate.id}-title`}>
          <header class="specimen-heading">
            <div>
              <span>Candidate</span>
              <h2 id={`${candidate.id}-title`}>{candidate.display}</h2>
            </div>
            <p>{candidate.note}</p>
          </header>

          <div class="reference-context" aria-label={`${candidate.display} reference-context mock`}>
            <div class="context-nav">
              <strong>DREAMWHEELS <b>AI</b></strong>
              <nav aria-label="Reference navigation"><span>Как это работает</span><span>Примеры</span><span>FAQ</span></nav>
              <div><span>Войти</span><button type="button">Попробовать <i aria-hidden="true">→</i></button></div>
            </div>
            <div class="context-hero">
              <div class="context-copy">
                <small>YOUR CAR. NEW POSSIBILITIES.</small>
                <h3>БОЛЬШЕ<br />СТИЛЯ<br />В ВАШИХ<br />РУКАХ</h3>
                <p>Примерьте конкретные диски на свой автомобиль и посмотрите, как они выглядят. С предварительной проверкой совместимости.</p>
                <button type="button">Примерить диски на своей машине <i aria-hidden="true">→</i></button>
              </div>
              <div class="context-car" aria-hidden="true"></div>
            </div>
            <div class="context-catalog">
              <aside>
                <small>ВЫБЕРИТЕ АВТОМОБИЛЬ</small>
                <b>ZEEKR 001</b>
                <span>BMW X5</span>
                <span>MERCEDES-BENZ GLE</span>
                <span>LI AUTO L7</span>
                <span>GEELY CITYRAY</span>
              </aside>
              <div class="catalog-main">
                <small>5 ПОПУЛЯРНЫХ ДИСКОВ ДЛЯ ZEEKR 001</small>
                <div class="wheel-row">
                  <b>OZ<br /><em>SUPERTURISMO</em></b><span>BBS<br /><em>FI-R</em></span><span>RAYS<br /><em>VOLK RACING</em></span><span>VOSSEN<br /><em>HF-5</em></span><span>HRE<br /><em>P101</em></span>
                </div>
                <div class="catalog-car" aria-hidden="true"></div>
              </div>
              <dl>
                <dt>OZ SUPERTURISMO</dt><dd>A motorsport classic.</dd>
                <div><b>R19</b><b>8.5J</b><b>5×112</b><b>ET40</b></div>
                <p><i>✓</i> Предварительно совместимо</p>
                <button type="button">Посмотреть детали →</button>
              </dl>
            </div>
          </div>

          <div class="specimen-grid">
            <article class="headline-sample">
              <span>Hero headline</span>
              <h3>БОЛЬШЕ<br />СТИЛЯ<br />В ВАШИХ<br />РУКАХ</h3>
              <h3 lang="en">MORE<br />STYLE<br />IN YOUR<br />HANDS</h3>
            </article>
            <article class="ui-sample">
              <span>Header / UI / technical values</span>
              <strong>DREAM WHEELS <b>AI</b></strong>
              <p>Как это работает　 Примеры　 FAQ　 Войти　 <mark>Попробовать</mark></p>
              <hr />
              <div class="vehicle-list">ZEEKR 001　 BMW X5　 MERCEDES-BENZ GLE　 LI AUTO L7　 GEELY CITYRAY</div>
              <div class="values"><b>R19</b><b>8.5J</b><b>5×112</b><b>ET40</b><b>DIA 66.6</b></div>
              <p>Предварительно совместимо　 Проверить совместимость　 Посмотреть детали →</p>
            </article>
            <article class="heading-sample">
              <span>Section-heading sample</span>
              <p>КАК ВЫГЛЯДИТ?</p>
              <p>ПОДХОДИТ ЛИ ТЕХНИЧЕСКИ?</p>
              <p>ОТ ФОТО ДО РЕЗУЛЬТАТА<br />ЗА НЕСКОЛЬКО ШАГОВ</p>
            </article>
          </div>
        </section>
      ))}

      <section class="system-audition" data-system-audition aria-labelledby="system-audition-title">
        <header class="audition-intro system-audition-intro">
          <span>Dream Wheels / typography systems</span>
          <h2 id="system-audition-title">Three systems.<br />One reference.</h2>
          <p>Identical reference-context layout, sizing, spacing and content. Only font-family role assignment changes.</p>
        </header>

        {systems.map((system) => (
          <section class="system-specimen" data-system={system.id} style={`--support-family: "${system.supportFamily}", sans-serif;`} aria-labelledby={`${system.id}-title`}>
            <header class="specimen-heading">
              <div>
                <span>{system.label}</span>
                <h3 id={`${system.id}-title`}>{system.display}</h3>
              </div>
              <p>{system.note}</p>
            </header>

            <div class="system-reference-context" aria-label={`${system.display} reference-context mock`}>
              <div class="system-context-nav">
                <strong class="role-display">DREAMWHEELS <b>AI</b></strong>
                <nav aria-label="Reference navigation"><span class="role-support">Как это работает</span><span class="role-support">Примеры</span><span class="role-support">FAQ</span></nav>
                <div><span class="role-support">Войти</span><button type="button" class="role-support">Попробовать <i aria-hidden="true">→</i></button></div>
              </div>
              <div class="system-context-hero">
                <div class="system-context-copy">
                  <small class="role-support">YOUR CAR. NEW POSSIBILITIES.</small>
                  <h4 class="role-display">БОЛЬШЕ<br />СТИЛЯ<br />В ВАШИХ<br />РУКАХ</h4>
                  <p class="role-support">Примерьте конкретные диски на свой автомобиль и посмотрите, как они выглядят. С предварительной проверкой совместимости.</p>
                  <button type="button" class="role-support">Примерить диски на своей машине <i aria-hidden="true">→</i></button>
                </div>
                <div class="system-context-car" aria-hidden="true"></div>
              </div>
              <div class="system-context-catalog">
                <aside>
                  <small class="role-support">ВЫБЕРИТЕ АВТОМОБИЛЬ</small>
                  <b class="role-display">ZEEKR 001</b>
                  <span class="role-support">BMW X5</span>
                  <span class="role-support">MERCEDES-BENZ GLE</span>
                  <span class="role-support">LI AUTO L7</span>
                  <span class="role-support">GEELY CITYRAY</span>
                </aside>
                <div class="system-catalog-main">
                  <small class="role-support">5 ПОПУЛЯРНЫХ ДИСКОВ ДЛЯ ZEEKR 001</small>
                  <div class="system-wheel-row">
                    <b class="role-display">OZ<br /><em class="role-support">SUPERTURISMO</em></b>
                    <span class="role-display">BBS<br /><em class="role-support">FI-R</em></span>
                    <span class="role-display">RAYS<br /><em class="role-support">VOLK RACING</em></span>
                    <span class="role-display">VOSSEN<br /><em class="role-support">HF-5</em></span>
                    <span class="role-display">HRE<br /><em class="role-support">P101</em></span>
                  </div>
                  <div class="system-catalog-car" aria-hidden="true"></div>
                </div>
                <dl class="system-catalog-rail">
                  <dt class="role-display">OZ SUPERTURISMO</dt>
                  <dd class="role-support">A motorsport classic.</dd>
                  <div class="system-values role-display"><b>R19</b><b>8.5J</b><b>5×112</b><b>ET40</b><b>DIA 66.6</b></div>
                  <p class="role-support"><i>✓</i> Предварительно совместимо. Требует проверки.</p>
                  <button type="button" class="role-support">Посмотреть детали →</button>
                </dl>
              </div>
            </div>

            <div class="system-evidence-grid">
              <article class="system-secondary">
                <span class="role-support">Secondary heading + body</span>
                <h4 class="role-support">КАК ВЫГЛЯДИТ?</h4>
                <p class="role-support">Реалистичная визуализация показывает характер диска на автомобиле.</p>
              </article>
              <article class="system-faq">
                <span class="role-support">FAQ question</span>
                <p class="role-support">Проверяете ли вы реальную совместимость?</p>
                <small class="role-support">Visual try-on and technical fitment remain separate.</small>
              </article>
              <article class="system-language">
                <span class="role-support">Russian + English samples</span>
                <h4 class="role-display">MORE STYLE<br />В ВАШИХ РУКАХ</h4>
                <p class="role-support">Choose a wheel, then check the numbers.</p>
              </article>
            </div>
          </section>
        ))}

        <section class="button-audition" aria-labelledby="button-audition-title">
          <header class="specimen-heading">
            <div>
              <span>Follow-up / IBM Plex Sans core</span>
              <h3 id="button-audition-title">Button-only alternatives</h3>
            </div>
            <p>Everything remains IBM Plex Sans. Only button typography changes.</p>
          </header>
          <div class="button-variant-grid">
            {buttonVariants.map((variant) => (
              <article class="button-variant" data-button-variant={variant.id} style={`--button-family: "${variant.family}", sans-serif;`}>
                <div class="button-variant-heading">
                  <span>IBM Plex Sans base</span>
                  <h4>{variant.label}</h4>
                  <p>{variant.note}</p>
                </div>
                <div class="button-variant-surface">
                  <div class="button-variant-copy">
                    <small>HERO CTA</small>
                    <strong>Примерьте конкретные диски на свой автомобиль.</strong>
                    <p>Visual try-on stays separate from technical fitment.</p>
                  </div>
                  <div class="button-variant-actions">
                    <button type="button" class="button-variant-primary">Примерить диски на своей машине <i aria-hidden="true">→</i></button>
                    <button type="button" class="button-variant-secondary">Посмотреть детали →</button>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      </section>
    </main>
    <script>
      const requested = new URLSearchParams(window.location.search).get('candidates')?.split(',').filter(Boolean);
      if (requested?.length) {
        document.querySelectorAll<HTMLElement>('[data-candidate]').forEach((specimen) => {
          specimen.hidden = !requested.includes(specimen.dataset.candidate ?? '');
        });
      }
      if (new URLSearchParams(window.location.search).get('systems') === 'only') {
        document.querySelectorAll<HTMLElement>('[data-candidate], .audition-intro:not(.system-audition-intro)').forEach((element) => {
          element.hidden = true;
        });
      }
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { background: #050b0e; color: #eef0ec; }
  :global(body) { margin: 0; background: #050b0e; }
  :global(button) { font: inherit; }
  .audition { width: min(100%, 1220px); margin: 0 auto; padding: 54px 5vw 96px; }
  .audition-intro { max-width: 570px; padding-bottom: 68px; font-family: Onest, sans-serif; }
  .audition-intro span, .specimen-heading span, .headline-sample > span, .ui-sample > span, .heading-sample > span { color: #aab4b9; font-size: 10px; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; }
  .audition-intro h1 { max-width: 560px; margin: 16px 0 18px; font-size: clamp(46px, 6.2vw, 76px); font-weight: 300; letter-spacing: -.06em; line-height: .87; }
  .audition-intro p { max-width: 430px; margin: 0; color: #aab4b9; font-size: 14px; line-height: 1.45; }
  .specimen { --candidate: Onest, sans-serif; margin: 0; padding: 44px 0 58px; border-top: 1px solid rgba(214, 229, 235, .16); font-family: var(--candidate); }
  .specimen-heading { display: flex; align-items: end; justify-content: space-between; gap: 32px; margin-bottom: 24px; }
  .specimen-heading h2 { margin: 7px 0 0; font-size: 30px; font-weight: 500; letter-spacing: -.04em; }
  .specimen-heading p { max-width: 270px; margin: 0; color: #aab4b9; font-size: 12px; text-align: right; }
  .reference-context { overflow: hidden; border: 1px solid rgba(214, 229, 235, .14); background: #060d10; box-shadow: 0 20px 60px rgba(0,0,0,.22); }
  .context-nav { display: flex; align-items: center; justify-content: space-between; min-height: 48px; padding: 0 22px; border-bottom: 1px solid rgba(214, 229, 235, .12); font-size: 9px; }
  .context-nav strong { font-size: 12px; font-weight: 600; letter-spacing: -.04em; }
  .context-nav b, .ui-sample b { color: #c2e823; }
  .context-nav nav { display: flex; gap: 24px; color: #cad0d2; }
  .context-nav > div { display: flex; align-items: center; gap: 18px; }
  .context-nav button, .context-copy button { border: 0; border-radius: 3px; background: #c2e823; color: #11160d; cursor: default; font-size: 9px; font-weight: 650; }
  .context-nav button { height: 28px; padding: 0 13px; }
  .context-nav i, .context-copy i { font-style: normal; font-size: 13px; }
  .context-hero { position: relative; min-height: 246px; overflow: hidden; }
  .context-hero::after { position: absolute; inset: 0; background: linear-gradient(90deg, #050b0e 0%, rgba(5,11,14,.76) 25%, rgba(5,11,14,.08) 60%, rgba(5,11,14,.18) 100%); content: ''; pointer-events: none; }
  .context-copy { position: relative; z-index: 2; width: 25%; min-width: 220px; padding: 25px 0 24px 24px; }
  .context-copy small { color: #cdd4d5; font-size: 7px; letter-spacing: .25em; }
  .context-copy h3 { margin: 8px 0 12px; color: #e9eced; font-size: clamp(25px, 3.2vw, 38px); font-weight: 300; letter-spacing: -.045em; line-height: .9; }
  .context-copy p { max-width: 205px; margin: 0; color: #e1e5e5; font-size: 9px; line-height: 1.3; }
  .context-copy button { min-height: 28px; margin-top: 13px; padding: 0 12px; }
  .context-car, .catalog-car { position: absolute; background-image: linear-gradient(90deg, transparent 0%, rgba(5,11,14,.1) 100%), url('/assets/mock/zeekr-001.webp'); background-repeat: no-repeat; background-size: cover; background-position: 50% 47%; filter: brightness(.72) saturate(.78) contrast(1.14); }
  .context-car { inset: 0 0 0 21%; }
  .context-catalog { display: grid; grid-template-columns: 19% minmax(0, 1fr) 25%; min-height: 267px; border-top: 1px solid rgba(214, 229, 235, .12); }
  .context-catalog aside { display: flex; flex-direction: column; gap: 8px; padding: 17px 14px 14px 22px; border-right: 1px solid rgba(214, 229, 235, .12); color: #cdd3d4; font-size: 9px; }
  .context-catalog aside small, .catalog-main > small { color: #aab4b9; font-size: 7px; letter-spacing: .12em; }
  .context-catalog aside b { position: relative; color: #eef0ec; font-weight: 600; }
  .context-catalog aside b::after { position: absolute; bottom: -4px; left: 0; width: 22px; height: 1px; background: #c2e823; content: ''; }
  .catalog-main { position: relative; overflow: hidden; padding: 17px 18px; }
  .wheel-row { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; margin-top: 10px; }
  .wheel-row > * { min-height: 47px; padding: 7px 6px; border: 1px solid rgba(214,229,235,.1); color: #d6dcdd; font-size: 8px; font-weight: 500; }
  .wheel-row b { position: relative; border-color: rgba(194,232,35,.3); }
  .wheel-row b::after { position: absolute; right: 0; bottom: -1px; left: 0; height: 1px; background: #c2e823; content: ''; }
  .wheel-row em { color: #9da8ab; font-size: 6px; font-style: normal; }
  .catalog-car { top: 64px; right: -4px; bottom: -16px; left: -43px; background-position: 50% 72%; opacity: .78; }
  .context-catalog dl { position: relative; z-index: 2; margin: 0; padding: 111px 21px 15px 17px; border-left: 1px solid rgba(214,229,235,.12); background: linear-gradient(90deg, rgba(5,11,14,.12), #050b0e 40%); }
  .context-catalog dt { font-size: 12px; font-weight: 500; }
  .context-catalog dd { margin: 4px 0 11px; color: #aab4b9; font-size: 8px; }
  .context-catalog dl div { display: flex; justify-content: space-between; gap: 5px; font-size: 8px; }
  .context-catalog dl p { display: flex; align-items: center; gap: 6px; margin: 12px 0 8px; padding: 7px 6px; background: rgba(214,229,235,.08); color: #e6e9e7; font-size: 8px; }
  .context-catalog dl p i { display: grid; width: 12px; height: 12px; place-items: center; border-radius: 50%; background: #c2e823; color: #0b100b; font-size: 8px; font-style: normal; }
  .context-catalog dl button { width: 100%; height: 24px; border: 0; border-radius: 2px; background: #edf0ee; color: #141718; font-size: 8px; font-weight: 600; }
  .specimen-grid { display: grid; grid-template-columns: 1.1fr 1.5fr 1fr; gap: 1px; margin-top: 18px; border: 1px solid rgba(214,229,235,.14); background: rgba(214,229,235,.14); }
  .specimen-grid article { min-height: 238px; padding: 20px; background: #071014; }
  .headline-sample h3 { margin: 14px 0 0; color: #edf0ee; font-size: 29px; font-weight: 300; letter-spacing: -.045em; line-height: .9; }
  .headline-sample h3 + h3 { margin-top: 19px; color: #b9c2c5; }
  .ui-sample strong { display: block; margin: 14px 0; font-size: 14px; font-weight: 600; letter-spacing: -.035em; }
  .ui-sample p, .vehicle-list { margin: 0; color: #c8d0d2; font-size: 10px; line-height: 1.5; }
  .ui-sample mark { padding: 2px 5px; background: #c2e823; color: #11160d; }
  .ui-sample hr { border: 0; border-top: 1px solid rgba(214,229,235,.14); margin: 14px 0; }
  .values { display: flex; justify-content: space-between; gap: 5px; margin: 16px 0 12px; color: #eef0ec; font-feature-settings: 'tnum' 1; font-size: 15px; font-weight: 600; }
  .heading-sample p { margin: 15px 0 0; color: #edf0ee; font-size: 19px; font-weight: 300; letter-spacing: -.04em; line-height: .94; }
  .system-audition { margin-top: 30px; padding-top: 30px; border-top: 1px solid rgba(214, 229, 235, .2); }
  .system-audition-intro { padding-bottom: 42px; }
  .system-audition-intro h2 { max-width: 560px; margin: 16px 0 18px; font-size: clamp(46px, 6.2vw, 76px); font-weight: 300; letter-spacing: -.06em; line-height: .87; }
  .system-specimen { --display-family: "IBM Plex Sans", sans-serif; --support-family: "IBM Plex Sans", sans-serif; margin: 0; padding: 44px 0 58px; border-top: 1px solid rgba(214, 229, 235, .16); font-family: var(--support-family); }
  .system-specimen .role-display { font-family: var(--display-family); }
  .system-specimen .role-support { font-family: var(--support-family); }
  .system-specimen[data-system="system-a"] { --display-family: "IBM Plex Sans", sans-serif; --support-family: "IBM Plex Sans", sans-serif; }
  .system-specimen[data-system="system-b"] { --display-family: "IBM Plex Sans", sans-serif; }
  .system-specimen[data-system="system-c"] { --display-family: "IBM Plex Sans", sans-serif; }
  .system-specimen > .specimen-heading h3 { font-family: var(--display-family); }
  .system-reference-context { overflow: hidden; border: 1px solid rgba(214, 229, 235, .14); background: #060d10; box-shadow: 0 20px 60px rgba(0,0,0,.22); }
  .system-context-nav { display: flex; align-items: center; justify-content: space-between; min-height: 48px; padding: 0 22px; border-bottom: 1px solid rgba(214, 229, 235, .12); font-size: 9px; }
  .system-context-nav strong { font-size: 12px; font-weight: 600; letter-spacing: -.04em; }
  .system-context-nav strong b { color: #c2e823; }
  .system-context-nav nav { display: flex; gap: 24px; color: #cad0d2; }
  .system-context-nav > div { display: flex; align-items: center; gap: 18px; }
  .system-context-nav button, .system-context-copy button { border: 0; border-radius: 3px; background: #c2e823; color: #11160d; cursor: default; font-size: 9px; font-weight: 650; }
  .system-context-nav button { height: 28px; padding: 0 13px; }
