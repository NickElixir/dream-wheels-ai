
> build
> npm run build:harness && npm run build:app-auth


> build:harness
> esbuild auth/harness.js --bundle --format=esm --target=es2020 --minify --outfile=auth/harness.bundle.js && node auth/normalize-bundle.mjs


> build:app-auth
> esbuild auth/app-auth.js --bundle --format=iife --target=es2020 --minify --outfile=auth/app-auth.bundle.js && node auth/normalize-bundle.mjs ./app-auth.bundle.js
