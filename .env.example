DATABASE_URL=
REDIS_URL=
REDIS_KEY_PREFIX=
REDIS_JOB_QUEUE=job_queue
WORKER_ENABLED=true

REVE_API_KEY=
BOT_TOKEN=
API_INTERNAL_TOKEN=

SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PUBLIC_BASE_URL=http://127.0.0.1:10000
API_BASE_URL=http://127.0.0.1:10000
WEBAPP_URL=https://dream-wheels-ai-webapp.vercel.app
LEGAL_BASE_URL=https://dream-wheels-ai-legal.vercel.app

STARTER_GRANT_CREDITS=3
STARTER_GRANT_TTL_DAYS=30
JOB_CREDIT_COST=1
PAYMENTS_ENABLED=true
WEBAPP_DEV_AUTH_ENABLED=false

# Telegram website auth
# Required now: backend-issued website bearer token and nonce signing.
TELEGRAM_AUTH_TOKEN_SECRET=
# Public client identifier used by the official Telegram Login JS library.
TELEGRAM_LOGIN_CLIENT_ID=
# Required later only for backend Authorization Code exchange.
TELEGRAM_LOGIN_CLIENT_SECRET=
TELEGRAM_LOGIN_ISSUER=https://oauth.telegram.org
TELEGRAM_LOGIN_JWKS_URL=https://oauth.telegram.org/.well-known/jwks.json
TELEGRAM_AUTH_TOKEN_TTL_SEC=3600
TELEGRAM_LOGIN_NONCE_TTL_SEC=600

# Robokassa live credentials
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_PASSWORD3=
ROBOKASSA_PAYMENT_URL=https://auth.robokassa.ru/Merchant/Index.aspx
# Robokassa test credentials
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
ROBOKASSA_HASH_ALGO=md5
ROBOKASSA_IS_TEST=false

# Production two-stage fitment verdict (see src/fitment and docs)
FITMENT_VERDICT_ENABLED=false
FITMENT_DB_PERSISTENCE=false

# Wheel-Size API v2 — a separate key from AITUNNEL.
WHEEL_SIZE_API_KEY=
WHEEL_SIZE_BASE_URL=https://api.wheel-size.com/v2
WHEEL_SIZE_REGION_DEFAULT=russia
WHEEL_SIZE_TIMEOUT_CONNECT_SEC=5
WHEEL_SIZE_TIMEOUT_READ_SEC=20
WHEEL_SIZE_MAX_RETRIES=3
FITMENT_CATALOG_CACHE_TTL_SEC=604800
FITMENT_PROFILE_CACHE_TTL_SEC=86400

# AITUNNEL OpenAI-compatible Vision API.
FITMENT_VLM_BASE_URL=https://api.aitunnel.ru/v1
FITMENT_VLM_API_KEY=
FITMENT_VLM_MODEL=gpt-4.1-mini
FITMENT_VLM_MIN_CONFIDENCE=0.4
FITMENT_VLM_TIMEOUT_SEC=60
FITMENT_VLM_MAX_RETRIES=3

# Preliminary upload normalization.
FITMENT_IMAGE_MAX_BYTES=10485760
FITMENT_IMAGE_LONG_SIDE_PX=1536
FITMENT_IMAGE_MAX_PIXELS=40000000

# Rim product URL enrichment. Keep allow-all disabled in production.
FITMENT_RIM_URL_RESOLVER_ENABLED=true
FITMENT_RIM_URL_ALLOWED_HOSTS=
FITMENT_RIM_URL_ALLOW_ALL_PUBLIC=false
FITMENT_RIM_URL_MAX_REDIRECTS=3
FITMENT_RIM_URL_MAX_BYTES=2097152
FITMENT_RIM_URL_TIMEOUT_CONNECT_SEC=5
FITMENT_RIM_URL_TIMEOUT_READ_SEC=10
FITMENT_RIM_URL_TIMEOUT_TOTAL_SEC=15
FITMENT_RIM_URL_MAX_RETRIES=2
FITMENT_RIM_URL_RETRY_BACKOFF_SEC=0.25
FITMENT_RIM_URL_USER_AGENT=DreamWheelsAI-Fitment/1.0
FITMENT_RIM_URL_CACHE_TTL_SEC=300
FITMENT_RIM_URL_CACHE_MAX_ENTRIES=128
